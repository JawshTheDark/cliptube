{
  "expo": {
    "name": "OurTube",
    "slug": "cliptube",
    "version": "1.4.0",
    "scheme": "cliptube",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0e0d16",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "so.irc.cliptube"
    },
    "android": {
      "package": "so.irc.cliptube",
      "versionCode": 6,
      "adaptiveIcon": {
        "backgroundColor": "#0e0d16",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "intentFilters": [
        {
          "action": "VIEW",
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ],
          "data": [
            {
              "scheme": "https",
              "host": "clips.irc.so",
              "pathPrefix": "/watch/"
            },
            {
              "scheme": "https",
              "host": "clips.irc.so",
              "pathPrefix": "/c/"
            },
            {
              "scheme": "https",
              "host": "clips.irc.so",
              "pathPrefix": "/n/"
            },
            {
              "scheme": "https",
              "host": "clips.irc.so",
              "pathPrefix": "/playlist/"
            },
            {
              "scheme": "https",
              "host": "clips.irc.so",
              "pathPrefix": "/party/"
            },
            {
              "scheme": "https",
              "host": "clips.irc.so",
              "pathPrefix": "/live/"
            },
            {
              "scheme": "https",
              "host": "clips.quitlyingto.us",
              "pathPrefix": "/watch/"
            },
            {
              "scheme": "https",
              "host": "clips.quitlyingto.us",
              "pathPrefix": "/c/"
            },
            {
              "scheme": "https",
              "host": "clips.quitlyingto.us",
              "pathPrefix": "/n/"
            },
            {
              "scheme": "https",
              "host": "clips.quitlyingto.us",
              "pathPrefix": "/playlist/"
            },
            {
              "scheme": "https",
              "host": "clips.quitlyingto.us",
              "pathPrefix": "/party/"
            },
            {
              "scheme": "https",
              "host": "clips.quitlyingto.us",
              "pathPrefix": "/live/"
            },
            {
              "scheme": "https",
              "host": "clips.6697.pro",
              "pathPrefix": "/watch/"
            },
            {
              "scheme": "https",
              "host": "clips.6697.pro",
              "pathPrefix": "/c/"
            },
            {
              "scheme": "https",
              "host": "clips.6697.pro",
              "pathPrefix": "/n/"
            },
            {
              "scheme": "https",
              "host": "clips.6697.pro",
              "pathPrefix": "/playlist/"
            },
            {
              "scheme": "https",
              "host": "clips.6697.pro",
              "pathPrefix": "/party/"
            },
            {
              "scheme": "https",
              "host": "clips.6697.pro",
              "pathPrefix": "/live/"
            }
          ]
        }
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-video",
        {
          "supportsBackgroundPlayback": false,
          "supportsPictureInPicture": true
        }
      ],
      "expo-image",
      "expo-secure-store",
      [
        "expo-font",
        {
          "android": {
            "fonts": [
              {
                "fontFamily": "PlusJakartaSans",
                "fontDefinitions": [
                  {
                    "path": "./node_modules/@expo-google-fonts/plus-jakarta-sans/400Regular/PlusJakartaSans_400Regular.ttf",
                    "weight": 400
                  },
                  {
                    "path": "./node_modules/@expo-google-fonts/plus-jakarta-sans/500Medium/PlusJakartaSans_500Medium.ttf",
                    "weight": 500
                  },
                  {
                    "path": "./node_modules/@expo-google-fonts/plus-jakarta-sans/600SemiBold/PlusJakartaSans_600SemiBold.ttf",
                    "weight": 600
                  },
                  {
                    "path": "./node_modules/@expo-google-fonts/plus-jakarta-sans/700Bold/PlusJakartaSans_700Bold.ttf",
                    "weight": 700
                  },
                  {
                    "path": "./node_modules/@expo-google-fonts/plus-jakarta-sans/800ExtraBold/PlusJakartaSans_800ExtraBold.ttf",
                    "weight": 800
                  }
                ]
              },
              {
                "fontFamily": "BricolageGrotesque",
                "fontDefinitions": [
                  {
                    "path": "./node_modules/@expo-google-fonts/bricolage-grotesque/600SemiBold/BricolageGrotesque_600SemiBold.ttf",
                    "weight": 600
                  },
                  {
                    "path": "./node_modules/@expo-google-fonts/bricolage-grotesque/700Bold/BricolageGrotesque_700Bold.ttf",
                    "weight": 700
                  },
                  {
                    "path": "./node_modules/@expo-google-fonts/bricolage-grotesque/800ExtraBold/BricolageGrotesque_800ExtraBold.ttf",
                    "weight": 800
                  }
                ]
              }
            ]
          }
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 160,
          "backgroundColor": "#0e0d16"
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ],
      "./plugins/withReleaseSigning",
      "./plugins/withShortNativePaths"
    ],
    "experiments": {
      "typedRoutes": false
    }
  }
}
